# Local dev only. In Docker, docker-compose.yml builds DATABASE_URL for you.
# Required: the app refuses to start without it.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/journal

# The class every student is enrolled in on first sign-in.
CLASS_PROGRAM_CODE=NETWORK-CYBER

# Where "Sign out" sends people.
AUTHELIA_LOGOUT_URL=https://auth.beattietech.local/logout
